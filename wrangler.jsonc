{
  "name": "anan-geo-public-site",
  "compatibility_date": "2026-11-25",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/rss.xml", "/llms-full.txt", "/admin/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anan-geo-db",
      "database_id": "67a2c274-6a07-41eb-827c-99722bf5ed92"
    }
  ]
  // === 必要密鑰（請於 Cloudflare Dashboard → Settings → Variables and Secrets 設定為 Secret，絕勿寫入檔案）===
  // - GEO_ADMIN_PASSWORD：/admin/ 雲端後台登入密碼（未設定時會安全拒絕登入並顯示設定提示）
  // - GEO_ADMIN_SESSION_SECRET（選填）：HMAC-SHA256 Cookie 簽章額外密鑰（未設時以 GEO_ADMIN_PASSWORD 衍生）
}
